{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs18",
    "timeoutSeconds": 300,
    "memory": "256MB",
    "environmentVariables": {}
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
