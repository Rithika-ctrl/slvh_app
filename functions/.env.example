# Twilio Configuration (Recommended for development)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
TWILIO_TEMPLATE_NAMESPACE=your_namespace
TWILIO_TEMPLATE_SID=your_template_sid

# WhatsApp Business API Configuration (For production)
WHATSAPP_BUSINESS_PHONE_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCESS_TOKEN=your_access_token
WHATSAPP_BUSINESS_TEMPLATE_NAME=order_status_update
